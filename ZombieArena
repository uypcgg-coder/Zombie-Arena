    isKecil = not isKecil
    
    if isKecil then
        -- Mengecil jadi ukuran 90x90 (kotak pas)
        TweenService:Create(frame, tweenInfo, {Size = UDim2.new(0, 90, 0, 90)}):Play()
        -- Hilangkan teks credit
        TweenService:Create(icon, tweenInfo, {TextTransparency = 1}):Play()
        TweenService:Create(credits, tweenInfo, {TextTransparency = 1}):Play()
        -- Munculkan Teks Logo Kecil
        TweenService:Create(miniLogo, tweenInfo, {TextTransparency = 0}):Play()
    else
        -- Membesar balik ke ukuran awal
        TweenService:Create(frame, tweenInfo, {Size = UDim2.new(0, 320, 0, 90)}):Play()
        -- Munculkan teks credit
        TweenService:Create(icon, tweenInfo, {TextTransparency = 0}):Play()
        TweenService:Create(credits, tweenInfo, {TextTransparency = 0}):Play()
        -- Hilangkan Teks Logo Kecil
        TweenService:Create(miniLogo, tweenInfo, {TextTransparency = 1}):Play()
    end
end)

local creditValue = player:WaitForChild("Credits")

local function FormatNumber(num)
	if num >= 1e12 then
		return string.format("%.2f", num / 1e12):gsub("%.?0+$", "") .. "T"
	elseif num >= 1e9 then
		return string.format("%.2f", num / 1e9):gsub("%.?0+$", "") .. "B"
	elseif num >= 1e6 then
		return string.format("%.2f", num / 1e6):gsub("%.?0+$", "") .. "M"
	elseif num >= 1e3 then
		return string.format("%.2f", num / 1e3):gsub("%.?0+$", "") .. "K"
	else
		return tostring(num)
	end
end

local function UpdateCredits()
	credits.Text = FormatNumber(creditValue.Value)
end

UpdateCredits()
creditValue.Changed:Connect(UpdateCredits)

