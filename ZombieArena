-- === LOGIKA ANIMASI (TWEEN) DITARUH DI ATAS ===
-- (Biar nggak keblokir sama WaitForChild)
local isKecil = false
local tweenInfo = TweenInfo.new(0.5, Enum.EasingStyle.Quart, Enum.EasingDirection.Out)

-- Pake 'Activated' lebih responsif (terutama buat layar sentuh/mobile)
